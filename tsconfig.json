{
    "compilerOptions": {
        "target": "es2023",
        "moduleResolution": "bundler",
        "module": "es2022",
        "skipLibCheck": true,
        "strict": true,
        "noImplicitAny": true,
        "outDir": "cache",
        "rootDir": "src",
        "paths": {
            "@*": ["./src/*"]
        }
    },
    "include": ["./src"],
    "exclude": ["./src/midis"]
}
