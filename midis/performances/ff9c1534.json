{
  "song": "ff9c1534",
  "title": "打上花火 · 海边防波堤的夏夜",
  "sections": [
    {
      "at": 0,
      "label": "序幕 · 夏夜海岸",
      "note": "2.825 秒八音盒质感轻柔起音，远景暮色海平线与低位藏青微光海波浮现，稀疏夜星点亮。"
    },
    {
      "at": 21,
      "label": "第一幕 · 防波堤漫步",
      "note": "DAOKO 轻柔女声主歌，海面波光染上极淡樱粉倒影，琴键化作清浅星尘。"
    },
    {
      "at": 38.525,
      "label": "第二幕 · 仰望夜空",
      "note": "铺陈蓄势段，海波渐亮并延展宽幅；59.4 秒悬停瞬间射出第一道升空花火引信。"
    },
    {
      "at": 60.175,
      "label": "第三幕 · 初绽（正圆菊花）",
      "note": "副歌炸响：正圆菊花与牡丹大玉在夜空左右接力绽放，海面同步映出粉金碎波。"
    },
    {
      "at": 80.35,
      "label": "第四幕 · 少年心事",
      "note": "夜空回归深邃开阔留白，海风微漾，琴键切为清透海蓝气泡（蓝眼泪）。"
    },
    {
      "at": 114,
      "label": "第五幕 · 祭典升温",
      "note": "波光加速跃动推升情绪，135.2 秒双发升空引信齐射入云。"
    },
    {
      "at": 136,
      "label": "第六幕 · 从侧面看？（扁平花火）",
      "note": "从正圆双玉切入高扁平度大倾角切面花火——仿佛绕到烟花侧面，窥见“如果”的平行时空。"
    },
    {
      "at": 155,
      "label": "第七幕 · 玻璃弹珠（もしも）",
      "note": "花火暂歇，后景浮起倾斜旋动的琉璃星环象征抛向空中的玻璃弹珠，172 秒触发棱晶折射。"
    },
    {
      "at": 177.9,
      "label": "第八幕 · 灯塔与渚",
      "note": "全曲最安静的海风清唱段：清空繁杂灯阵，仅余唯一一道冷月灯塔斜光与轻柔海波。"
    },
    {
      "at": 204,
      "label": "第九幕 · 盛夏终章花火",
      "note": "灯塔退场，多轮升空火束接连引爆牡丹、菊花与垂柳金雨，整片海面彻底被烟火照亮。"
    },
    {
      "at": 250,
      "label": "第十幕 · 漫天锦冠垂柳",
      "note": "Animenz 炫技巅峰段：261.5–265 秒三连发超大半径垂柳金雨大玉伴随重拍冲击与圣光扇束盛放。"
    },
    {
      "at": 268,
      "label": "尾声 · 夏夜余烬",
      "note": "花火落尽，暖金微星化作缓缓沉入海面的余烬，海波重归藏青并渐暗熄灭于 285.8 秒。"
    }
  ],
