{
  "song": "e1563b03",
  "title": "Secret · 时门",
  "sections": [
    {
      "at": 0,
      "label": "前奏 · 旧琴",
      "note": "1.625 秒低 E 起音。外围浮起冷月 Bokeh 星尘，琴键上空升起银辉流萤音符 ♪。"
    },
    {
      "at": 6.1,
      "label": "主题 · 回声",
      "note": "高音旋律进入。地面星环扫光展开主题，双翼流光彗星沿琴身两侧优雅盘旋，上方双螺旋星芒开始回旋。"
    },
    {
      "at": 24.175,
      "label": "发展 · 第一重时间",
      "note": "跑动加密、低音加深。极光天幕与落樱花瓣在后景展开，32 秒时空光拱门起势，42 秒随高音走句染为琥珀暖金并亮起圣光扇束冠冕与琴键星座连线。"
    },
    {
      "at": 54.1,
      "label": "回落 · 悬停",
      "note": "高音跑动停顿，舞台收束为低暗冷月蓝星尘与微弱流萤，留白蓄势。"
    },
    {
      "at": 64.075,
      "label": "再现 · 时门开启",
      "note": "主题再现。星辰法阵、时空光拱与双翼流光重燃；66.65s 与 71.075s 两次冰蓝琉璃棱晶时空回卷，仿佛时间倒流。"
    },
    {
      "at": 72.025,
      "label": "高潮 · 穿越",
      "note": "72.05s 与 74.20s 双波密集高潮：地面冲击波扩散、全开圣光冠冕、耀金棱晶向外裂变与高空烟花盛放。"
    },
    {
      "at": 79.9,
      "label": "尾奏 · 合拢",
      "note": "最后一次银白碎晶轻柔回卷合拢，各通道依次淡出，星尘伴随踏板尾音收束于 86.1 秒。"
    }
  ],
