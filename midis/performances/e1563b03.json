{
  "song": "e1563b03",
  "title": "Secret · 时门",
  "sections": [
    {
      "at": 0,
      "label": "前奏 · 旧琴",
      "note": "1.643 秒低 E 起音。先留黑，随后在琴和演奏者外围浮起淡蓝星尘。"
    },
    {
      "at": 6.1,
      "label": "主题 · 回声",
      "note": "弱奏中的高音线延伸。侧边银丝随音高抬落，星尘继续为中心留白。"
    },
    {
      "at": 24.175,
      "label": "发展 · 第一重时间",
      "note": "24 秒后跑动加密，32 秒进入更重的低音型。先把银丝交给蓝色后幕，42 秒一轮高音将幕拉长，随后压回。"
    },
    {
      "at": 54.1,
      "label": "回落 · 悬停",
      "note": "高音跑动停下，低音型继续。后幕缩暗，撤掉暖光，为再次抬升留出空间。"
    },
    {
      "at": 64.075,
      "label": "再现 · 时门开启",
      "note": "高音型重现。冷蓝后幕托住纵深，琥珀两翼从后侧揭开；冰蓝玻璃碎片第一次逆向聚拢。"
    },
    {
      "at": 72.025,
      "label": "高潮 · 穿越",
      "note": "72–76 秒音符最密。碎片沿琴身两侧聚拢、金色裂开，再聚拢、再次向外抛开；扇束随两波起伏，中间短暂回收。"
    },
    {
      "at": 79.9,
      "label": "尾奏 · 合拢",
      "note": "最后一串高音后，碎片短暂逆行，暖光和蓝色后幕依次收拢。星尘跟随踏板延音收尾。"
    }
  ],
