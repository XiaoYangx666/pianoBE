{
  "song": "e1563b03",
  "title": "Secret · 旧琴房与倒转的二十年",
  "sections": [
    {
      "at": 0,
      "label": "序幕 · 暗场",
      "note": "琴房暗场留白，0.8 秒起微弱暖尘缓缓浮现。"
    },
    {
      "at": 1.625,
      "label": "第一幕 · 旧琴房",
      "note": "E 小调巴赫对位起音，两道午后暖金高窗斜光切入琴房，琴键仅留克制微光。"
    },
    {
      "at": 13.125,
      "label": "第二幕 · 古谱的秘密",
      "note": "主题复现，极简时空表盘在地面低位顺时针缓缓启动，古谱魔力初醒。"
    },
    {
      "at": 24.4,
      "label": "第三幕 · 琴声与悬停",
      "note": "古典音阶流动，单侧丝光轻掠呼应右手走句；31.2 秒表盘减速悬停蓄势。"
    },
    {
      "at": 33.325,
      "label": "第四幕 · 逆转启动",
      "note": "B7 全和弦与低音脉冲开启，地面扫光点亮，四束冷暖交叉追光切入，表盘开始倒转。"
    },
    {
      "at": 41.775,
      "label": "第五幕 · 第一重穿越",
      "note": "表盘抬起加速倒转，时空裂隙光流与两翼丝光展开，浮尘反重力升腾，46 秒高音触发棱晶回卷。"
    },
    {
      "at": 52.575,
      "label": "第六幕 · 空间压缩",
      "note": "琴房坍塌前的紧绷压迫：追光灯位向内收窄，表盘半径收缩、深钴蓝背光随低音持续呼吸。"
    },
    {
      "at": 63.825,
      "label": "第七幕 · 加速破壁",
      "note": "第二重高音冲刺，表盘与追光骤然外扩，时空裂隙畸变加剧，69 秒再度高音回卷。"
    },
    {
      "at": 71.35,
      "label": "第八幕 · 急促的琴键",
      "note": "终极狂想高潮：单环重拍冲击、圣光扇束全开、表盘高速倒转、时空裂隙与彗星撕裂穿过舞台，77 秒归于炽白金穿透之光。"
    },
    {
      "at": 80.725,
      "label": "间歇 · Blackout",
      "note": "终极和弦落下伴随轻柔回卷，全部舞台灯阵于 0.7 秒内骤收熄灭。"
    },
    {
      "at": 81.675,
      "label": "尾声 · 1979 的晨光",
      "note": "0.95 秒静默后孤音 E7 响起，舞台仅余唯一一道暖金斜窗晨光与缓降微尘，渐暗收束于 86.1 秒。"
    }
  ],
