{
  "song": "c8159589",
  "title": "secret base · 夏末花火",
  "sections": [
    {
      "at": 0,
      "label": "第一幕 · 暮色初启",
      "note": "2.200s 低音琶音入场。远景铺开低亮暮色天际霞光，夏末微风卷起稀疏小白花，琴键泛起暖象牙星火微光。"
    },
    {
      "at": 17.075,
      "label": "第二幕 · 夏日回声",
      "note": "高八度风铃旋律进入。天际霞光收淡，轻柔穿场丝带与淡粉银白音符随高音浮起。"
    },
    {
      "at": 31.725,
      "label": "第三幕 · 秘密基地",
      "note": "主歌叙事展开，黄昏渐沉入蓝调时刻。低位流萤初现，小白花随风横掠，琴键星座在长音间连起星点回忆。"
    },
    {
      "at": 60.9,
      "label": "第四幕 · 暮色初涌",
      "note": "60.9s 扫地转场进入预副歌，75.575s 首次副歌以夏夜深靛天际、满庭流萤与暖金丝带托举，刻意克制不放烟花；86s 起长淡出清场。"
    },
    {
      "at": 96.6,
      "label": "第五幕 · 八音盒之夜",
      "note": "纯高音区清澈独奏。舞台大面积留白，仅留月白星尘、冰白雪晶键光与少量流萤；112s 渐入倾斜星环蓄势。"
    },
    {
      "at": 126.875,
      "label": "第六幕 · 仲夏初绽",
      "note": "第二次副歌开启，星环退场，双翼流光与花瓣雨展开；141.325s 与 146.8s 首次呈现「龙势升空 → 单朵花火」错拍绽放。"
    },
    {
      "at": 165.025,
      "label": "第七幕 · 翻涌与追忆",
      "note": "C 段主动切换空间语言：撤掉丝带与烟花，以暮紫琥珀双螺旋星轨与双侧柔光幕呼应十年之约；193.5s 起彻底清场。"
    },
    {
      "at": 198.7,
      "label": "第八幕 · 十年后的八月",
      "note": "全曲最催泪的纯高音留白独白，舞台几乎全空，仅留微弱星尘与几缕纯白无名花；214s 流萤聚拢蓄势，226.8s 龙势火箭冲天直指终极副歌。"
    },
    {
      "at": 228.6,
      "label": "第九幕 · 花火与告别",
      "note": "228.6s–255s 终极副歌四发龙势错色花火与暖金扇束释放；256s 后退回暮光余温与落花流萤；286.425s 终章八音盒中纯白无名花缓缓向上升散，随 309.525s 末音余韵合拢于晨光。"
    }
  ],
