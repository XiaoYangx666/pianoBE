{
  "song": "b0cae095",
  "title": "火花 · 迪亚玛特之夜",
  "sections": [
    {
      "at": 0,
      "label": "第一幕 · 宇宙微光",
      "note": "1.675s 晶莹分解和弦引入。极简深空星尘与冰白音符；25s 绯红组纽红绳首次绕琴轻舞。"
    },
    {
      "at": 60.35,
      "label": "第二幕 · 暮色初临",
      "note": "悬停呼吸后进入主歌 1。新海诚式黄昏云海在后景缓缓铺开，琴键星座连起冰蓝与绯红（全段刻意隐藏流星）。"
    },
    {
      "at": 92.725,
      "label": "第三幕 · 命运交织",
      "note": "副歌 1 展开。绯红与冰蓝双股组纽加速交织环绕，黄昏云海染上夕阳暮紫与珊瑚粉。"
    },
    {
      "at": 150.25,
      "label": "第四幕 · 黄昏之时",
      "note": "かたわれ時（黄昏之时）。后景盛放浓郁的珊瑚红与落日琥珀云海，金粉微光随夏末晚风缓漂。"
    },
    {
      "at": 206.5,
      "label": "第五幕 · 穿越黄昏",
      "note": "副歌 2 双通道绯红与冰蓝组纽如时空交错般高速盘旋，直至 258.675s 戛然而止。"
    },
    {
      "at": 258.675,
      "label": "第六幕 · 真空静默",
      "note": "长达 6.65 秒的绝对黑暗与静默，全场光影瞬间归零，屏息等待迪亚玛特。"
    },
    {
      "at": 265.325,
      "label": "第七幕 · 孤星迪亚玛特",
      "note": "极高音星点落下。278s 与 305s 一颗孤独而巨大的迪亚玛特彗星无声滑过深空，318.9s 心跳低音蓄势冲顶。"
    },
    {
      "at": 325.55,
      "label": "第八幕 · 彗星分裂 · 初降流星雨",
      "note": "5:25.55 最高音冲顶瞬间，迪亚玛特彗星在天顶一分为二！5:26.52 全曲首次释放璀璨划空流星雨，无任何遮挡弧线，纯净震撼。"
    },
    {
      "at": 358.7,
      "label": "第九幕 · 星落系守湖 · 晨光红线",
      "note": "5:58.70 二次彗星分裂，终极惊喜「星落湖面」登场——流星碎片坠落琴周激起发光湖面涟漪与星光水花，与双向流星雨共振；6:18.82 巨响后喧嚣骤静，一缕绯红组纽缓缓升入晨曦云海。"
    }
  ],
