    },
    "stageProps": [
        {
            "id": "sinner_sword",
            "geometry": "stage_props/sinner_sword.geo.json",
            "texture": "stage_props/sinner_sword.png",
            "merTexture": "stage_props/sinner_sword_mer.png",
            "preview": {
                "tall": true,
                "fullGlow": true
