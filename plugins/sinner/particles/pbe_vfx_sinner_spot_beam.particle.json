{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "pbe:vfx_sinner_spot_beam",
            "basic_render_parameters": {
                "material": "particles_add",
                "texture": "textures/particle/pbe_sinner_spot_beam"
            }
        },
        "components": {
            "minecraft:emitter_rate_instant": {
                "num_particles": 1
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 0.05
            },
            "minecraft:emitter_shape_point": {
                "offset": [
                    0,
                    0,
                    0
                ]
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": "(variable.vfx_life ?? 1.08)"
            },
            "minecraft:particle_appearance_billboard": {
                "facing_camera_mode": "lookat_y",
                "size": [
                    "(variable.vfx_width ?? 1)",
                    "(variable.vfx_depth ?? 1)"
                ],
                "uv": {
                    "texture_width": 128,
                    "texture_height": 128,
                    "uv": [
                        0,
                        0
                    ],
                    "uv_size": [
                        128,
                        128
                    ]
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": [
                    "(variable.vfx_red ?? 1)",
                    "(variable.vfx_green ?? 1)",
                    "(variable.vfx_blue ?? 1)",
                    "(variable.vfx_opacity ?? 0.7) * math.clamp(variable.particle_age / 0.32, 0, 1) * math.clamp((variable.particle_lifetime - variable.particle_age) / 0.49, 0, 1)"
                ]
            }
        }
    }
}
