{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "pbe:vfx_floral_ground",
            "basic_render_parameters": {
                "material": "particles_blend",
                "texture": "textures/particle/pbe_floral_ground"
            }
        },
        "components": {
            "minecraft:emitter_rate_instant": { "num_particles": 1 },
            "minecraft:emitter_lifetime_once": { "active_time": 0.05 },
            "minecraft:emitter_local_space": { "position": true, "rotation": true },
            "minecraft:emitter_shape_point": { "offset": [0, 0, 0] },
            "minecraft:particle_initial_spin": { "rotation": "(variable.vfx_spin ?? 0)" },
            "minecraft:particle_lifetime_expression": { "max_lifetime": "(variable.vfx_life ?? 1.65)" },
            "minecraft:particle_appearance_billboard": {
                "facing_camera_mode": "emitter_transform_xz",
                "size": [
                    "(variable.vfx_width ?? 1) * (variable.vfx_scale ?? 1)",
                    "(variable.vfx_depth ?? 1) * (variable.vfx_scale ?? 1)"
                ],
                "uv": { "texture_width": 128, "texture_height": 128, "uv": [0, 0], "uv_size": [128, 128] }
            },
            "minecraft:particle_appearance_tinting": {
                "color": [
                    1, 1, 1,
                    "(variable.vfx_opacity ?? 0.7) * math.clamp(variable.particle_age / 0.56, 0, 1) * math.clamp((variable.particle_lifetime - variable.particle_age) / 0.55, 0, 1)"
                ]
            }
        }
    }
}
