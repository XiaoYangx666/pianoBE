{
    "compilerOptions": {
        "target": "es2022",
        "module": "es2022",
        "moduleResolution": "bundler",
        "lib": ["es2022"],
        "outDir": "dist",
        "rootDir": ".",
        "strict": true,
        "declaration": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "incremental": true,
        "tsBuildInfoFile": "../build/.cache/tsbuildinfo/plugins.tsbuildinfo"
    },
    "include": ["index.ts", "*/vfx/**/*.ts", "*/plugin.json"]
}
