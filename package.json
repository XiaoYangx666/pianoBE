{
    "name": "pianobe",
    "type": "module",
    "license": "GPL-3.0-only",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "overrides": {
        "@minecraft/server": "2.10.0",
        "@minecraft/server-ui": "2.2.0",
        "@minecraft/server-net": "1.0.0-beta.1.26.50-stable",
        "@minecraft/server-admin": "1.0.0-beta.1.26.50-stable"
    },
    "scripts": {
        "pack": "npm run pack -w @piano/addon",
        "dev": "npm run dev -w @piano/addon",
        "build": "npm run build -w @piano/addon",
        "copy": "npm run copy -w @piano/addon",
        "build:template": "npm run build:template -w @piano/addon",
        "build:server": "npm run build:server -w @piano/addon",
        "verify:addon-build": "npm run verify:build -w @piano/addon",
        "convert": "node tools/convert.js",
        "add-song": "node tools/add-song.mjs",
        "show-song": "node tools/show-song.mjs",
        "import:midis": "node tools/import-midis.mjs",
        "migrate:library": "node tools/migrate-legacy-library.mjs",
        "bench:pbe2": "node tools/bench-pbe2.mjs",
        "build:core": "npm run build -w @piano/core",
        "build:ci": "npm run build:core && npm run build:template && npm run build:generator",
        "build:all": "npm run build:core && npm run build:template && npm run build:generator && npm run build:web && npm run build:server && npm run build && node tools/verify-addon-build.mjs client",
        "test": "npm run test -w @piano/core",
        "dev:server": "npm run dev -w @piano/server",
        "start:server": "npm run start -w @piano/server",
        "debug:server": "npm run debug -w @piano/server",
        "test:server": "npm run test -w @piano/server",
        "dev:web": "npm run dev -w @piano/web",
        "start:web": "npm run preview -w @piano/web",
        "build:web": "npm run build -w @piano/web",
        "dev:generator": "npm run dev -w @piano/generator",
        "build:generator": "npm run build -w @piano/generator",
        "build:timbres": "node tools/build-piano-timbres.mjs",
        "verify:timbres": "bun tools/verify-timbres.mjs",
        "vendor:tabletop": "node tools/pack-tabletop.mjs"
    },
    "devDependencies": {
        "@minecraft/server": "2.10.0",
        "@minecraft/server-ui": "2.2.0",
        "typescript": "^5.5.0"
    },
    "allowScripts": {
        "esbuild": true
    }
}
