{
    "name": "pianobe",
    "type": "module",
    "license": "CC-BY-NC-4.0",
    "private": true,
    "workspaces": [
        "packages/*",
        "plugins"
    ],
    "overrides": {
        "@minecraft/server": "2.11.0",
        "@minecraft/server-ui": "2.3.0",
        "@minecraft/server-net": "1.0.0-beta.1.26.50-stable",
        "@minecraft/server-admin": "1.0.0-beta.1.26.50-stable"
    },
    "scripts": {
        "dev": "npm run dev -w @piano/addon",
        "build": "npm run build -w @piano/addon",
        "build:dev": "npm run build -w @piano/addon",
        "deploy:dev": "npm run deploy -w @piano/addon",
        "copy": "npm run copy -w @piano/addon",
        "build:template": "npm run build:template -w @piano/addon",
        "build:server": "npm run build:server -w @piano/addon",
        "verify:addon-build": "npm run verify:build -w @piano/addon",
        "build:release": "node tools/verify/check-all.mjs build:release",
        "verify:release": "node tools/verify/check-all.mjs verify:release",
        "dev:server": "npm run dev -w @piano/server",
        "start:server": "npm run start -w @piano/server",
        "test:server": "bun run --cwd packages/server test",
        "deploy:bds": "node tools/deploy/deploy-bds.mjs",
        "build:server:exe": "bun tools/build/build-server-exe.ts",
        "docker:single": "npm run build:server:exe && docker build -f Dockerfile.server -t pianobe-server:single .",
        "dev:studio": "npm run dev -w @piano/studio",
        "build:studio": "npm run build -w @piano/studio",
        "build:studio:server": "npm run build:server -w @piano/studio",
        "dev:web": "npm run dev -w @piano/web",
        "build:web": "npm run build -w @piano/web",
        "build:core": "npm run build -w @piano/core",
        "build:vfx": "npm run build -w @piano/vfx",
        "build:plugins": "npm run build -w @piano/plugins",
        "build:assembly": "npm run build -w @piano/assembly",
        "pack:plugins": "bun tools/plugins/pack-plugin.mjs --all && bun tools/plugins/pack-official-libraries.mjs && bun tools/plugins/pack-official-timbres.mjs",
        "validate:plugins": "bun tools/plugins/validate-plugin.mjs --all",
        "assets:vfx": "node tools/assets/build-vfx-lab.mjs",
        "sync:vfx-assets": "node tools/assets/sync-vfx-assets.mjs --host-only",
        "sync:samples": "node tools/assets/sync-web-samples.mjs",
        "build:timbres": "node tools/audio/build-piano-timbres.mjs",
        "verify:timbres": "bun tools/verify/verify-timbres.mjs",
        "test": "node tools/verify/check-all.mjs test",
        "test:core": "bun run --cwd packages/core test",
        "test:vfx": "bun run --cwd packages/vfx test",
        "test:assembly": "bun run --cwd packages/assembly test",
        "test:addon": "bun run --cwd packages/addon test",
        "test:studio": "bun run --cwd packages/studio test",
        "typecheck": "node tools/verify/check-all.mjs typecheck",
        "check": "node tools/verify/check-all.mjs",
        "check:full": "npm run check && npm run build:release && npm run verify:release",
        "check:vfx": "node tools/verify/check-all.mjs check:vfx",
        "midi": "node tools/midi/cli.mjs",
        "audio-lab": "node tools/audio/cli.mjs"
    },
    "devDependencies": {
        "@minecraft/server": "2.11.0",
        "@minecraft/server-ui": "2.3.0",
        "typescript": "^5.5.0"
    },
    "allowScripts": {
        "esbuild": true
    }
}
