# PianoBE 后端配置。复制为 .env 使用：
# - bun 本地运行（packages/server 下）自动加载；WEB_ROOT 需指向 web 构建产物
# - docker compose（根目录）也会读取此 .env，但 compose 的 environment 优先
# 未设置项使用默认值

# 监听端口
PORT=3000

# SQLite 数据文件（曲目 meta/播放列表/令牌）
DB_PATH=./data/piano.db

# 管理员引导令牌；留空则首次启动自动生成并打印到控制台
BOOTSTRAP_TOKEN=

# 日志文件；默认 ./data/logs/server.log（单文件 5 MB，轮转保留 3 个）
# 设为 off 则只输出到控制台
LOG_FILE=./data/logs/server.log

# 为 true 时曲目列表/曲目内容/公开播放列表免令牌可读
ALLOW_PUBLIC_READ=false

# 前端构建产物静态目录（bun 本地运行时从 packages/server 出发：../web/dist）
WEB_ROOT=../web/dist

# --- 音频转 MIDI（AMT）---
# Rust CLI 与模型；留空时自动查找 ./amt/（npm run sync:amt 生成）
# 模型默认优先 run4_int8.onnx，缺失时回退 run4_best.onnx
AMT_CLI=
AMT_MODEL=
# native = 纯 Rust 解码；ffmpeg = 外部 ffmpeg（支持更多格式）
AMT_DECODER=native
AMT_THREADS=4
# 同时运行的转录任务数（默认 1；每个任务会开一个 amt-cli 子进程，CPU/内存紧张时保持 1）
AMT_CONCURRENCY=1
# 最多排队的转录任务数（默认 10，防止大量上传占满临时目录）
AMT_MAX_QUEUE=10
# 单个音频/视频最大时长（秒，默认 600）；B 站视频会在下载前直接拒绝
AMT_MAX_AUDIO_SECONDS=600
# B 站音频下载字节上限（默认 200 MB，流式读取超限即中止）
AMT_MAX_DOWNLOAD_BYTES=209715200
AMT_ECO=false
AMT_TIMEOUT_MS=600000

# B 站 SESSDATA（可选，仅杜比 / Hi-Res 音轨需要登录）
BILI_SESSDATA=
