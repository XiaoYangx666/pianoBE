# PianoBE 后端配置。复制为 .env 使用：
# - bun 本地运行（apps/server 下）自动加载；WEB_ROOT 需指向 web 构建产物
# - docker compose（根目录）也会读取此 .env，但 compose 的 environment 优先
# 未设置项使用默认值

# 监听端口
PORT=3000

# SQLite 数据文件（曲目 meta/播放列表/令牌）
DB_PATH=./data/piano.db

# 曲目内容目录（存 {id}.mid 源文件，需 JSON 时按需转换）
MIDIS_DIR=./data/midis

# 管理员引导令牌；留空则首次启动自动生成并打印到控制台
BOOTSTRAP_TOKEN=

# 为 true 时曲目列表/曲目内容/公开播放列表免令牌可读
ALLOW_PUBLIC_READ=false

# 前端构建产物静态目录（bun 本地运行时从 apps/server 出发：../web/dist）
WEB_ROOT=../web/dist
