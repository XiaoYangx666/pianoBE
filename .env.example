# PianoBE 后端配置。复制为 .env 使用：
# - 单文件服务端：放在可执行文件同目录（或运行目录 `--dir`）下，按当前目录作为根目录
# - 源码运行（packages/server 下）：自动加载，相对于 PIANOBE_HOME（默认当前目录）解析路径
# 未设置项使用默认值

# 监听端口
PORT=3000

# 服务端运行根目录（相当于 MC Server 目录，也可通过命令行 `--dir <path>` 指定）
# 默认当前工作目录；其下自动组织 plugins/、data/、logs/
PIANOBE_HOME=

# 数据目录（默认 <PIANOBE_HOME>/data，存 piano.db / scores/ / server-template.mcaddon / amt/）
DATA_DIR=
# SQLite 数据文件（默认 <DATA_DIR>/piano.db）
DB_PATH=

# 外置插件目录（默认 <PIANOBE_HOME>/plugins；直接放入/删除 .pbeplugin 即可识别）
PLUGINS_DIR=
# 可选远程插件清单 URL（例如面向玩家网页版的 /plugins/index.json），配好后可在管理页一键下载官方插件
PLUGIN_REGISTRY_URL=

# 管理员引导令牌；留空则首次启动自动生成并打印到控制台
BOOTSTRAP_TOKEN=

# 日志文件；默认 <PIANOBE_HOME>/logs/server.log（单文件 10 MB，轮转保留 7 个）
# 设为 off 则只输出到控制台
LOG_FILE=
# 最低级别：debug / info / warn / error（默认 info；debug 会记录健康检查等高频日志）
LOG_LEVEL=info
# 文件格式：text（人类可读）或 json（一行一条，便于 grep/jq）
LOG_FORMAT=text
# 单个日志文件上限（字节，默认 10485760）
LOG_MAX_BYTES=10485760
# 保留的历史日志文件数（默认 7）
LOG_MAX_FILES=7

# 为 true 时曲目列表/曲目内容/公开播放列表免令牌可读
ALLOW_PUBLIC_READ=false

# 前端构建产物静态目录（源码运行优先自动探测 studio/dist-server；单文件版自动内嵌）
WEB_ROOT=

# --- 音频转 MIDI（AMT）---
# 解析顺序：AMT_CLI（环境变量） > <DATA_DIR>/amt/（网页一键下载） > node_modules（npm 依赖） > PATH
# 仅在需要自定义（本地构建二进制 / 其他模型）时填写
AMT_CLI=
AMT_MODEL=
# 网页一键下载 AMT 时默认使用的 npm registry（默认 https://registry.npmmirror.com）
NPM_REGISTRY=
# native = 纯 Rust 解码；ffmpeg = 外部 ffmpeg（支持更多格式）
AMT_DECODER=native
AMT_THREADS=4
# 同时运行的转录任务数（默认 1；每个任务会开一个 amt-cli 子进程，CPU/内存紧张时保持 1）
AMT_CONCURRENCY=1
# 最多排队的转录任务数（默认 10，防止大量上传占满临时目录）
AMT_MAX_QUEUE=10
# 单个音频/视频最大时长（秒，默认 600）；B 站视频会在下载前直接拒绝
AMT_MAX_AUDIO_SECONDS=600
# B 站音频下载字节上限（默认 200 MB，流式读取超限即中止）
AMT_MAX_DOWNLOAD_BYTES=209715200
AMT_ECO=false
AMT_TIMEOUT_MS=600000

# B 站 SESSDATA（可选，仅杜比 / Hi-Res 音轨需要登录）
BILI_SESSDATA=

# --- BDS 附加包部署（管理页「BDS 部署」也可修改，页面配置优先）---
# BDS 根目录（例如 /server/server1 或 E:\BDS）
BDS_DIR=
# 目标世界目录名；留空时读 server.properties 的 level-name
BDS_WORLD=
# 部署到 BDS 的包目录名
BDS_BP_NAME=pianoServerBP
BDS_RP_NAME=pianoServerRP
# development = development_behavior_packs / development_resource_packs（推荐）
# release = behavior_packs / resource_packs
BDS_PACK_MODE=development
# manifest 中显示的名称/描述；留空沿用模板
BDS_PACK_NAME=
BDS_PACK_DESCRIPTION=
