{
    "name": "@piano/addon",
    "version": "0.1.0",
    "description": "钢琴附加包（游戏内显示与播放）",
    "type": "module",
    "license": "UNLICENSED",
    "private": true,
    "scripts": {
        "pack": "npm run build",
        "sync:assets": "node ../../tools/assets/sync-vfx-assets.mjs --host-only && bun --conditions=piano-source ../../tools/assets/sync-stage-props.mjs --host-only",
        "prepare:build": "npm run build -w @piano/core && npm run build -w @piano/vfx && npm run sync:assets",
        "dev": "npm run prepare:build && bepack dev",
        "build:base": "npm run prepare:build && bepack build --skip-copy",
        "build": "npm run build:template && bun ../../tools/build/assemble-dev-addon.mjs --pack",
        "deploy": "npm run build:template && bun ../../tools/build/assemble-dev-addon.mjs --copy",
        "copy": "bun ../../tools/build/assemble-dev-addon.mjs --copy",
        "build:template": "npm run prepare:build && bepack build --skip-copy --pack --mode template",
        "build:server": "npm run prepare:build && bepack build --config bepack.server.config.ts --skip-copy --pack",
        "build:release": "npm run sync:assets && bepack build --skip-copy --pack --mode template && bepack build --config bepack.server.config.ts --skip-copy --pack --skip-typecheck && bepack build --skip-copy --skip-pack --skip-typecheck",
        "verify:build": "node ../../tools/verify/verify-addon-build.mjs",
        "test": "bun test --conditions=piano-source --isolate"
    },
    "dependencies": {
        "@begame/minecraft": "0.1.1",
        "@minecraft/server": "2.11.0",
        "@minecraft/server-admin": "1.0.0-beta.1.26.50-stable",
        "@minecraft/server-net": "1.0.0-beta.1.26.50-stable",
        "@minecraft/server-ui": "2.3.0",
        "@minecraft/vanilla-data": "1.26.50",
        "@piano/core": "file:../core",
        "@piano/vfx": "file:../vfx",
        "sapi-pro": "0.4.4-stable"
    },
    "devDependencies": {
        "@bepack/cli": "^0.1.0-beta.9",
        "@piano/plugins": "file:../../plugins"
    }
}
