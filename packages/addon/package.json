{
    "name": "@piano/addon",
    "version": "0.1.0",
    "description": "钢琴附加包（游戏内显示与播放）",
    "type": "module",
    "license": "GPL-3.0-only",
    "private": true,
    "scripts": {
        "prepack": "node scripts/clean-manifest.mjs",
        "pack": "bepack pack",
        "dev": "bepack dev",
        "prebuild": "node scripts/clean-manifest.mjs",
        "build": "bepack build",
        "copy": "bepack copy",
        "prebuild:template": "node scripts/clean-manifest.mjs",
        "build:template": "bepack build --skip-copy --pack --mode template",
        "prebuild:server": "node scripts/clean-manifest.mjs",
        "build:server": "bepack build --config bepack.server.config.ts --skip-copy --pack",
        "test": "bun test"
    },
    "dependencies": {
        "@minecraft/server": "2.10.0-beta.1.26.44-stable",
        "@minecraft/server-ui": "2.2.0-beta.1.26.44-stable",
        "@minecraft/vanilla-data": "1.26.44",
        "@piano/core": "file:../core",
        "sapi-pro": "file:../../vendor/sapi-pro-0.4.2.tgz"
    },
    "devDependencies": {
        "@bepack/cli": "^0.1.0-beta.0",
        "@minecraft/server-admin": "^1.0.0-beta.11940b24",
        "@minecraft/server-net": "^1.0.0-beta.11940b24",
        "sapi-kit": "^0.2.3"
    }
}
