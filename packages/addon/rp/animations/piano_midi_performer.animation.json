{
    "format_version": "1.8.0",
    "animations": {
        "animation.pbe.performer.midi": {
            "loop": true,
            "animation_length": 1,
            "blend_weight": "!(variable.is_first_person ?? 0) || (query.get_equipped_item_name('main_hand') == '' && query.get_equipped_item_name('off_hand') == '')",
            "bones": {
                "waist": {
                    "rotation": [
                        "variable.is_first_person ? 0 : 7",
                        "t.on = (variable.is_first_person ?? 0) && (v.actions_and_stuff ?? 0) != 0 && q.get_equipped_item_name('main_hand') == '' && q.get_equipped_item_name('off_hand') == ''; v.oreville_offhand_visible = t.on ? 1 : (v.oreville_offhand_visible ?? 0); v.oreville_offhand_custom_pos = t.on ? 1 : (v.oreville_offhand_custom_pos ?? 0); v.oreville_mainhand_visible = t.on ? 1 : (v.oreville_mainhand_visible ?? 0); v.oreville_mainhand_custom_pos = t.on ? 1 : (v.oreville_mainhand_custom_pos ?? 0); return 0;",
                        "t.on = (variable.is_first_person ?? 0) && (v.actions_and_stuff ?? 0) == 0 && q.get_equipped_item_name('main_hand') == '' && q.get_equipped_item_name('off_hand') == ''; v.item_use_normalized = t.on ? 0.06 : (v.item_use_normalized ?? 0); return 0;"
                    ]
                },
                "leftarm": {
                    "rotation": [
                        "t.age = q.life_time - (v.pbe_left_note_at ?? -1); t.press = t.age >= 0 && t.age < 0.095; v.pbe_left_press = math.lerp(v.pbe_left_press ?? 0, t.press, math.clamp(q.delta_time * 25, 0, 1)); v.pbe_left_depth = math.lerp(v.pbe_left_depth ?? 0, v.pbe_left_black ?? 0, math.clamp(q.delta_time * 16, 0, 1)); return variable.is_first_person ? 94 + 8.5 * v.pbe_left_press - 2.5 * v.pbe_left_depth - this : -46.0 + 6.0 * v.pbe_left_press;",
                        "v.pbe_left_turn = math.lerp(v.pbe_left_turn ?? 0.35, v.pbe_left_outer ?? 0.35, math.clamp(q.delta_time * 12, 0, 1)); return variable.is_first_person ? (36 + 14.0 * v.pbe_left_turn - this) : 10 - 20.0 * v.pbe_left_turn;",
                        "variable.is_first_person ? (-110 + 4.0 * (v.pbe_left_press ?? 0) - 6.0 * (v.pbe_left_turn ?? 0.35) - this) : 0"
                    ],
                    "position": [
                        "variable.is_first_person ? (-9.6 - 4.4 * (v.pbe_left_turn ?? 0.35) - this) : 0",
                        "variable.is_first_person ? (-8.0 + 0.6 * (v.pbe_left_depth ?? 0) - 1.6 * (v.pbe_left_press ?? 0) - this) : 0",
                        "variable.is_first_person ? (12.0 + 1.2 * (v.pbe_left_depth ?? 0) + 0.6 * (v.pbe_left_press ?? 0) - this) : 0"
                    ]
                },
                "rightarm": {
                    "rotation": [
                        "t.age = q.life_time - (v.pbe_right_note_at ?? -1); t.press = t.age >= 0 && t.age < 0.095; v.pbe_right_press = math.lerp(v.pbe_right_press ?? 0, t.press, math.clamp(q.delta_time * 25, 0, 1)); v.pbe_right_depth = math.lerp(v.pbe_right_depth ?? 0, v.pbe_right_black ?? 0, math.clamp(q.delta_time * 16, 0, 1)); return variable.is_first_person ? 94 + 8.5 * v.pbe_right_press - 2.5 * v.pbe_right_depth - this : -46.0 + 6.0 * v.pbe_right_press;",
                        "v.pbe_right_turn = math.lerp(v.pbe_right_turn ?? 0.35, v.pbe_right_outer ?? 0.35, math.clamp(q.delta_time * 12, 0, 1)); return variable.is_first_person ? (-36 - 14.0 * v.pbe_right_turn - this) : -10 + 20.0 * v.pbe_right_turn;",
                        "variable.is_first_person ? (110 - 4.0 * (v.pbe_right_press ?? 0) + 6.0 * (v.pbe_right_turn ?? 0.35) - this) : 0"
                    ],
                    "position": [
                        "variable.is_first_person ? (9.6 + 4.4 * (v.pbe_right_turn ?? 0.35) - this) : 0",
                        "variable.is_first_person ? (-8.0 + 0.6 * (v.pbe_right_depth ?? 0) - 1.6 * (v.pbe_right_press ?? 0) - this) : 0",
                        "variable.is_first_person ? (12.0 + 1.2 * (v.pbe_right_depth ?? 0) + 0.6 * (v.pbe_right_press ?? 0) - this) : 0"
                    ]
                }
            }
        },
