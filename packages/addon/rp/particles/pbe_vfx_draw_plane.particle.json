{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "pbe:vfx_draw_plane",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/vfx_lab"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": true
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_initial_spin": {
        "rotation": "(variable.vfx_spin ?? 0)",
        "rotation_rate": "(variable.vfx_spin_rate ?? 0)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "((0) * (variable.vfx_right_x ?? 1) + (0) * (variable.vfx_right_z ?? 0)) * (variable.vfx_scale ?? 1)",
          "((variable.vfx_vy ?? 0) * variable.particle_age) * (variable.vfx_scale ?? 1)",
          "((0) * (variable.vfx_right_z ?? 0) - (0) * (variable.vfx_right_x ?? 1)) * (variable.vfx_scale ?? 1)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.max(0.1, (variable.vfx_life ?? 1.2))"
      },
      "minecraft:particle_appearance_billboard": {
        "facing_camera_mode": "emitter_transform_xz",
        "size": [
          "(math.lerp((variable.vfx_radius_start ?? 0.4), (variable.vfx_radius_end ?? 2.4), math.pow(math.clamp(variable.particle_age / math.max(0.01, variable.particle_lifetime), 0, 1), (variable.vfx_curve ?? 0.7))) * (variable.vfx_stage_depth ?? 1)) * (variable.vfx_scale ?? 1)",
          "(math.lerp((variable.vfx_radius_start ?? 0.4), (variable.vfx_radius_end ?? 2.4), math.pow(math.clamp(variable.particle_age / math.max(0.01, variable.particle_lifetime), 0, 1), (variable.vfx_curve ?? 0.7))) * (variable.vfx_stage_depth ?? 1)) * (variable.vfx_scale ?? 1)"
        ],
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "uv": [
            "(variable.vfx_style ?? 0) > 0.5 ? 896 : 0",
            "(variable.vfx_style ?? 0) > 0.5 ? 768 : 512"
          ],
          "uv_size": [
            "(variable.vfx_style ?? 0) > 0.5 ? 128 : 256",
            "(variable.vfx_style ?? 0) > 0.5 ? 128 : 256"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp((variable.vfx_red ?? 1), (variable.vfx_red2 ?? (variable.vfx_red ?? 1)), math.clamp(variable.particle_age / math.max(0.01, variable.particle_lifetime), 0, 1))",
          "math.lerp((variable.vfx_green ?? 1), (variable.vfx_green2 ?? (variable.vfx_green ?? 1)), math.clamp(variable.particle_age / math.max(0.01, variable.particle_lifetime), 0, 1))",
          "math.lerp((variable.vfx_blue ?? 1), (variable.vfx_blue2 ?? (variable.vfx_blue ?? 1)), math.clamp(variable.particle_age / math.max(0.01, variable.particle_lifetime), 0, 1))",
          "(variable.vfx_opacity ?? 0.8) * math.clamp((variable.particle_age) / math.max(0.01, (variable.vfx_fade_in ?? 0.16)), 0, 1) * math.clamp((variable.particle_lifetime - (variable.particle_age)) / math.max(0.01, (variable.vfx_fade_out ?? 0.35)), 0, 1)"
        ]
      }
    }
  }
}
