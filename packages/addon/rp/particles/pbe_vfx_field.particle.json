{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "pbe:vfx_field",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/vfx_lab"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "(variable.vfx_rate ?? 12)",
        "max_particles": "(variable.vfx_max_particles ?? 38)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "(variable.vfx_active ?? 2.1)"
      },
      "minecraft:emitter_shape_custom": {
        "offset": [
          "((math.cos(360 * variable.particle_random_1) * (1.49 + 1.32 * variable.particle_random_3) * (variable.vfx_range ?? 1)) * (variable.vfx_right_x ?? 1) + (math.sin(360 * variable.particle_random_1) * (1.49 + 1.32 * variable.particle_random_3) * (variable.vfx_range ?? 1) * 0.91 * (variable.vfx_stage_depth ?? 1)) * (variable.vfx_right_z ?? 0)) * (variable.vfx_scale ?? 1)",
          "(1.08 + (variable.vfx_height ?? 0) + 1.64 * (variable.particle_random_2 - 0.5)) * (variable.vfx_scale ?? 1)",
          "((math.cos(360 * variable.particle_random_1) * (1.49 + 1.32 * variable.particle_random_3) * (variable.vfx_range ?? 1)) * (variable.vfx_right_z ?? 0) - (math.sin(360 * variable.particle_random_1) * (1.49 + 1.32 * variable.particle_random_3) * (variable.vfx_range ?? 1) * 0.91 * (variable.vfx_stage_depth ?? 1)) * (variable.vfx_right_x ?? 1)) * (variable.vfx_scale ?? 1)"
        ],
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_initial_speed": [
        "((variable.particle_random_4 < 0.32 ? 0 : 0.22 * (variable.vfx_speed ?? 1) * (2 * variable.particle_random_3 - 1)) * (variable.vfx_right_x ?? 1) + (variable.particle_random_4 < 0.32 ? 0 : 0.17 * (variable.vfx_speed ?? 1) * (2 * variable.particle_random_2 - 1)) * (variable.vfx_right_z ?? 0)) * (variable.vfx_scale ?? 1)",
        "(variable.particle_random_4 < 0.32 ? 0 : 0.13 * (variable.vfx_speed ?? 1) * (2 * variable.particle_random_1 - 1)) * (variable.vfx_scale ?? 1)",
        "((variable.particle_random_4 < 0.32 ? 0 : 0.22 * (variable.vfx_speed ?? 1) * (2 * variable.particle_random_3 - 1)) * (variable.vfx_right_z ?? 0) - (variable.particle_random_4 < 0.32 ? 0 : 0.17 * (variable.vfx_speed ?? 1) * (2 * variable.particle_random_2 - 1)) * (variable.vfx_right_x ?? 1)) * (variable.vfx_scale ?? 1)"
      ],
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 0.38
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "1.2 + 2.0 * variable.particle_random_1"
      },
      "minecraft:particle_appearance_billboard": {
        "facing_camera_mode": "lookat_xyz",
        "size": [
          "((variable.vfx_size ?? 1) * (0.042 + 0.105 * math.pow(variable.particle_random_4, 2.6))) * (variable.vfx_scale ?? 1)",
          "((variable.vfx_size ?? 1) * (0.042 + 0.105 * math.pow(variable.particle_random_4, 2.6))) * (variable.vfx_scale ?? 1)"
        ],
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            "variable.particle_random_4 > 0.82 ? 32 : 0",
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(variable.vfx_red ?? 0.65)",
          "(variable.vfx_green ?? 0.72)",
          "(variable.vfx_blue ?? 0.98)",
          "(variable.vfx_opacity ?? 0.75) * math.clamp((variable.particle_age) / 0.78, 0, 1) * math.clamp((variable.particle_lifetime - (variable.particle_age)) / 0.86, 0, 1) * (0.26 + 0.63 * variable.particle_random_4) * (0.87 + 0.13 * math.sin(variable.particle_age * 180 + variable.particle_random_2 * 360))"
        ]
      }
    }
  }
}
