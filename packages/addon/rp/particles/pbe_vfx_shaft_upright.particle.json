{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "pbe:vfx_shaft_upright",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/vfx_lab"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "(variable.vfx_life ?? 1.6)"
      },
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": true
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "((0) * (variable.vfx_right_x ?? 1) + (0) * (variable.vfx_right_z ?? 0)) * (variable.vfx_scale ?? 1)",
          "(0.5 * (math.lerp((variable.vfx_previous_length ?? 2), (variable.vfx_length ?? 2), math.clamp(variable.particle_age / 0.8, 0, 1)))) * (variable.vfx_scale ?? 1)",
          "((0) * (variable.vfx_right_z ?? 0) - (0) * (variable.vfx_right_x ?? 1)) * (variable.vfx_scale ?? 1)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.vfx_life ?? 1.6)"
      },
      "minecraft:particle_appearance_billboard": {
        "facing_camera_mode": "lookat_y",
        "size": [
          "(0.5 * (variable.vfx_width ?? 0.15)) * (variable.vfx_scale ?? 1)",
          "(0.5 * (math.lerp((variable.vfx_previous_length ?? 2), (variable.vfx_length ?? 2), math.clamp(variable.particle_age / 0.8, 0, 1)))) * (variable.vfx_scale ?? 1)"
        ],
        "uv": {
          "texture_width": 1024,
          "texture_height": 1024,
          "uv": [
            164,
            2
          ],
          "uv_size": [
            48,
            44
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(variable.vfx_red ?? 0.66)",
          "(variable.vfx_green ?? 0.87)",
          "(variable.vfx_blue ?? 1)",
          "(variable.vfx_opacity ?? 0.75) * math.clamp((variable.particle_age) / 0.8, 0, 1) * math.clamp((variable.particle_lifetime - (variable.particle_age)) / 0.8, 0, 1)"
        ]
      }
    }
  }
}
