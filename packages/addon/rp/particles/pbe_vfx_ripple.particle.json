{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "pbe:vfx_ripple",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/vfx_lab"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "(variable.vfx_life ?? 1.1)"
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.vfx_life ?? 1.1)"
      },
      "minecraft:particle_appearance_billboard": {
        "facing_camera_mode": "emitter_transform_xz",
        "size": [
          "((variable.vfx_radius ?? 2.15) * (0.16 + 0.84 * math.pow(math.clamp(variable.particle_age / variable.particle_lifetime, 0, 1), 0.65)) * (variable.vfx_size ?? 1) * (variable.vfx_stage_depth ?? 1)) * (variable.vfx_scale ?? 1)",
          "((variable.vfx_radius ?? 2.15) * (0.16 + 0.84 * math.pow(math.clamp(variable.particle_age / variable.particle_lifetime, 0, 1), 0.65)) * (variable.vfx_size ?? 1) * (variable.vfx_stage_depth ?? 1)) * (variable.vfx_scale ?? 1)"
        ],
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            0,
            104
          ],
          "uv_size": [
            128,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(variable.vfx_red ?? 0.54)",
          "(variable.vfx_green ?? 0.89)",
          "(variable.vfx_blue ?? 0.86)",
          "(variable.vfx_opacity ?? 0.75) * math.clamp((variable.particle_age) / 0.13, 0, 1) * math.clamp((variable.particle_lifetime - (variable.particle_age)) / 0.65, 0, 1)"
        ]
      }
    }
  }
}
