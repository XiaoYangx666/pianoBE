{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "pbe:vfx_curtain",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/vfx_lab"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": "(variable.vfx_life ?? 1.38)"
      },
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": true
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "((0) * (variable.vfx_right_x ?? 1) + (0.21 * math.cos((variable.vfx_phase ?? 0) + 130 * (variable.vfx_speed ?? 1) * variable.particle_age)) * (variable.vfx_right_z ?? 0)) * (variable.vfx_scale ?? 1)",
          "(0.16 * math.sin((variable.vfx_phase ?? 0) + 130 * (variable.vfx_speed ?? 1) * variable.particle_age) - 0.32 * variable.particle_age) * (variable.vfx_scale ?? 1)",
          "((0) * (variable.vfx_right_z ?? 0) - (0.21 * math.cos((variable.vfx_phase ?? 0) + 130 * (variable.vfx_speed ?? 1) * variable.particle_age)) * (variable.vfx_right_x ?? 1)) * (variable.vfx_scale ?? 1)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.vfx_life ?? 1.38)"
      },
      "minecraft:particle_appearance_billboard": {
        "facing_camera_mode": "lookat_y",
        "size": [
          "(0.5 * (variable.vfx_width ?? 0.14)) * (variable.vfx_scale ?? 1)",
          "(0.5 * (variable.vfx_length ?? 1.4)) * (variable.vfx_scale ?? 1)"
        ],
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            96,
            0
          ],
          "uv_size": [
            32,
            48
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(variable.vfx_red ?? 0.55)",
          "(variable.vfx_green ?? 0.62)",
          "(variable.vfx_blue ?? 0.94)",
          "(variable.vfx_opacity ?? 0.75) * math.clamp((variable.particle_age) / 0.34, 0, 1) * math.clamp((variable.particle_lifetime - (variable.particle_age)) / 0.52, 0, 1)"
        ]
      }
    }
  }
}
