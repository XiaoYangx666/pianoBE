{
    "name": "@piano/generator",
    "version": "0.1.0",
    "description": "PianoBE 独立生成器：把 .mid 内嵌进 addon 模板并重新打包",
    "type": "module",
    "license": "GPL-3.0-only",
    "private": true,
    "scripts": {
        "predev": "node scripts/sync-template.mjs && node scripts/sync-library.mjs && node scripts/sync-timbres.mjs && node scripts/sync-amt.mjs",
        "dev": "vite",
        "prebuild": "node scripts/sync-template.mjs && node scripts/sync-library.mjs && node scripts/sync-timbres.mjs && node scripts/sync-amt.mjs",
        "build": "vite build",
        "preview": "vite preview",
        "sync:amt": "node scripts/sync-amt.mjs"
    },
    "dependencies": {
        "@bepack/addon": "^0.1.0-beta.9",
        "@piano/core": "file:../core",
        "@piano/ui": "file:../ui",
        "lucide-react": "^0.545.0",
        "onnxruntime-web": "^1.31.1",
        "pdfjs-dist": "^6.5.438",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.5",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^4.7.0",
        "tailwindcss": "^4.3.5",
        "typescript": "^5.5.0",
        "vite": "^6.0.0"
    }
}
