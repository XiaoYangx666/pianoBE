{
    "name": "@piano/studio",
    "version": "0.1.0",
    "description": "PianoBE Studio：统一的本地与服务器内容管理、扩展中心、音乐工具与附加包装配台",
    "type": "module",
    "license": "CC-BY-NC-4.0",
    "private": true,
    "scripts": {
        "sync": "bun scripts/sync.mjs",
        "predev": "bun scripts/sync.mjs",
        "dev": "vite",
        "prebuild": "bun scripts/sync.mjs",
        "build": "vite build",
        "preview": "vite preview",
        "test": "bun test --conditions=piano-source",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "build:server": "vite build --mode server",
        "prebuild:server": "bun scripts/sync.mjs --server"
    },
    "dependencies": {
        "@bepack/addon": "^0.1.0-beta.9",
        "@piano/assembly": "file:../assembly",
        "@piano/core": "file:../core",
        "@piano/ui": "file:../ui",
        "@piano/vfx": "file:../vfx",
        "fflate": "^0.8.3",
        "lucide-react": "^0.545.0",
        "onnxruntime-web": "^1.31.1",
        "pdfjs-dist": "^6.5.438",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.5",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^4.7.0",
        "tailwindcss": "^4.3.5",
        "typescript": "^5.5.0",
        "vite": "^6.0.0"
    }
}
