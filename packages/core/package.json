{
    "name": "@piano/core",
    "version": "0.1.0",
    "description": "PianoBE 共享核心库：MIDI 转换/打包、曲库与播放列表领域模型与存储端口",
    "type": "module",
    "license": "GPL-3.0-only",
    "private": true,
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./convert": {
            "types": "./dist/convert.d.ts",
            "import": "./dist/convert.js"
        },
        "./player": {
            "types": "./dist/midi/audioPlayer.d.ts",
            "import": "./dist/midi/audioPlayer.js"
        },
        "./note": {
            "types": "./dist/midi/note.d.ts",
            "import": "./dist/midi/note.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "vitest run"
    },
    "dependencies": {
        "@tonejs/midi": "^2.0.28"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "vitest": "^4.1.10"
    }
}
