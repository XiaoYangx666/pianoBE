{
    "compilerOptions": {
        "target": "es2022",
        "module": "es2022",
        "moduleResolution": "bundler",
        "lib": ["es2022", "DOM"],
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "declaration": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "incremental": true,
        "tsBuildInfoFile": "../../build/.cache/tsbuildinfo/assembly.tsbuildinfo"
    },
    "include": ["src"]
}
