{
    "name": "@piano/server",
    "version": "0.1.0",
    "description": "PianoBE 后端曲库管理服务（Hono + bun:sqlite）",
    "type": "module",
    "license": "CC-BY-NC-4.0",
    "private": true,
    "scripts": {
        "start": "bun src/index.ts",
        "dev": "bun --watch src/index.ts",
        "debug": "bun --inspect src/index.ts",
        "test": "bun test --conditions=piano-source --test-name-pattern=\"^(?!.*\\[artifact\\])\"",
        "test:artifacts": "bun test --conditions=piano-source tests/studioApi.test.ts --test-name-pattern=\"\\[artifact\\]\"",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@piano/assembly": "file:../assembly",
        "@piano/core": "file:../core",
        "@piano/vfx": "file:../vfx",
        "amt-cli": "0.1.1",
        "fflate": "^0.8.2",
        "hono": "^4.6.0"
    },
    "devDependencies": {
        "@types/bun": "^1.1.0",
        "typescript": "^5.5.0"
    }
}
