packages/addon/rp/textures/particle/
packages/addon/bp/entities/pbe_stage_props/
packages/addon/rp/entity/pbe_stage_props/
packages/addon/rp/models/entity/pbe_stage_props/
packages/addon/rp/animations/pbe_stage_props/
packages/addon/rp/textures/entity/pbe_stage_props/

__pycache__/

# 单文件服务端从当前目录运行时生成的默认目录
/data/
/logs/
packages/studio/public-server
packages/studio/dist-server

# 外置运行模型的默认日志目录
packages/server/logs/
