build
!/tools/build/
cache
node_modules
packages/web/public/replay
packages/web/public/piano
# Blockbench 切块工程是本地生成物（tools/model/*-cut 可重建），不入库
assets/*/cut/*.bbmodel
output.zip
/dist
bp/scripts
packages/*/bp/scripts
midis/files/*
midis/js/*
tools/piano_source/*
tools/piano_timbres_source/*
# 本地音频实验环境，不随正式仓库提交
tools/audio-lab/
packages/*/dist
plugins/dist
packages/*/data
packages/studio/public
.env
*.mid
*.mcaddon
# 私有依赖 @begame/tabletop，构建前用 npm run vendor:tabletop 生成（见 vendor/README.md）
vendor/*.tgz
# 本地测试曲谱（正式版由玩家在生成器里导入，不随模板发布）
assets/scores/
packages/addon/rp/textures/ui/piano_score/
packages/addon/rp/textures/entity/piano_score/*.png
!packages/addon/rp/textures/entity/piano_score/blank.png
*.dev.log

# VFX particle documents and textures are generated into packages/vfx/assets and synced into the RP
